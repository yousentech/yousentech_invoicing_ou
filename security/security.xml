<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data> 

       
		<record id="group_allow_modify_ou" model="res.groups">
		 
			<field name="name">Allow modify Operating unit</field>
			<field name="category_id" ref="yousentech_invoicing.invoice_category"/>
		</record>

		<record id="rule_account_move_ou" model="ir.rule">
			<field name="name">account move OU Rule</field>
			<field name="model_id" ref="account.model_account_move"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>

		<record id="rule_account_payment_ou" model="ir.rule">
			<field name="name">account_payment OU Rule</field>
			<field name="model_id" ref="account.model_account_payment"/>
			<field name="domain_force">
				['|',('operation_unit_id','=', False),('operation_unit_id', 'in', user.ou_config_ids.allowed_ou_ids.ids)]
			</field>
		</record>

    </data>
</odoo>
