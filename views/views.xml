<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =================== Account Move (Invoices / Bills) =================== -->
    <record id="view_account_move_form_ou" model="ir.ui.view">
        <field name="name">account.move.form.ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             
                <xpath expr = "//group[@id = 'header_left_group']" position="inside">
                    <field name="allow_modify_ou_flag" invisible="1"/>
                    <field name="operation_unit_id" force_save="1" domain="allowed_ou_domain" readonly="not allow_modify_ou_flag" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                </xpath>

                  
                <xpath expr = "//field[@name = 'invoice_line_ids']/tree/field[@name = 'account_id']" position="after">
                       <field name="operation_unit_id" force_save="1" optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
 			    </xpath>
                <xpath expr = "//field[@name = 'line_ids']/tree/field[@name = 'account_id']" position="after">
                     <field name="operation_unit_id" force_save="1" optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}" />
                </xpath>


        </field>
    </record>

    <!-- =================== Account Move tree =================== -->
    <record id="view_account_move_out_tree_ou" model="ir.ui.view">
        <field name="name">view_account_move_out_tree_ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
             
                <xpath expr = "//field[@name = 'company_id']" position="after">
                    <field name="operation_unit_id" optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                </xpath>

                   

        </field>
    </record>

    <record id="view_account_move_in_tree_ou" model="ir.ui.view">
        <field name="name">view_account_move_in_tree_ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
             
            <xpath expr = "//field[@name = 'company_id']" position="after">
                <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

                   

        </field>
    </record>

    <record id="view_account_move_entry_tree_ou" model="ir.ui.view">
        <field name="name">view_account_move_entry_tree_ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
             
            <xpath expr = "//field[@name = 'company_id']" position="after">
                <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>

                   

        </field>
    </record>

     <!-- =================== Account Move search =================== -->
    <record id="view_account_move_out_search_ou" model="ir.ui.view">
        <field name="name">view_account_move_out_search_ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="operation_unit_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>

      <!-- ===================view_account_payment_register_form   =================== -->
    <record id="view_account_payment_register_form_ou" model="ir.ui.view">
        <field name="name">view_account_payment_register_form_ou</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
             
                <xpath expr = "//field[@name = 'communication']" position="after">
                    <field name="operation_unit_id"  force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
                </xpath>
 

        </field>
    </record>

 
    <!-- =================== Account Payment form=================== -->
    <record id="view_account_payment_form_ou" model="ir.ui.view">
        <field name="name">account.payment.form.ou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="before">
              <field name="allow_modify_ou_flag" invisible="1"/>
                <field name="operation_unit_id" force_save="1"  readonly="not allow_modify_ou_flag" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>


     <!-- =================== Account Payment tree=================== -->
    <record id="view_account_payment_tree_ou" model="ir.ui.view">
        <field name="name">view_account_payment_tree_ou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_supplier_tree_ou" model="ir.ui.view">
        <field name="name">view_account_payment_supplier_tree_ou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="operation_unit_id"  optional="hide" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>
 <!-- =================== Account Payment search=================== -->
    <record id="view_account_payment_search_ou" model="ir.ui.view">
        <field name="name">view_account_payment_search_ou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
           <xpath expr="//search" position="inside">
                <field name="operation_unit_id"  options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,'no_create': True}"/>
            </xpath>
        </field>
    </record>

 
</odoo>
