<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     
    <!-- =================== Sale Order =================== -->
    <record id="view_sale_order_form_ou" model="ir.ui.view">
        <field name="name">sale.order.form.ou</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="operation_unit_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Purchase Order =================== -->
    <record id="view_purchase_order_form_ou" model="ir.ui.view">
        <field name="name">purchase.order.form.ou</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="operation_unit_id"   readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Stock Picking =================== -->
    <record id="view_stock_picking_form_ou" model="ir.ui.view">
        <field name="name">stock.picking.form.ou</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="operation_unit_id"   readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Account Move (Invoices / Bills) =================== -->
    <record id="view_account_move_form_ou" model="ir.ui.view">
        <field name="name">account.move.form.ou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="operation_unit_id"  readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Account Move Line =================== -->
    <record id="view_account_move_line_tree_ou" model="ir.ui.view">
        <field name="name">account.move.line.tree.ou</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="operation_unit_id"   readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- =================== Account Payment =================== -->
    <record id="view_account_payment_form_ou" model="ir.ui.view">
        <field name="name">account.payment.form.ou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="operation_unit_id"   readonly="1"/>
            </xpath>
        </field>
    </record>
 
</odoo>
